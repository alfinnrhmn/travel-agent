---
const explore = [
  { label: 'Solo Trips', href: '/package#solo' },
  { label: 'Couple Trips', href: '/package#couple' },
  { label: 'Group Trips', href: '/package#group' },
  { label: 'Popular Destinations', href: '/gallery' },
]

const support = [
  { label: 'FAQ', href: '#' },
  { label: 'Terms & Conditions', href: '#' },
  { label: 'Privacy Policy', href: '#' },
  { label: 'Refund & Cancellation Policy', href: '#' },
  { label: 'Contact Us', href: '/contact' },
]
---

<footer class="site-footer">
  <div class="footer-watermark" aria-hidden="true">TRIPOVA</div>

  <div class="footer-content">
    <div class="brand-column">
      <a href="/" class="brand-name">TRIPOVA</a>
      <p>Tripovia helps you turn every journey solo, together, or with family into a story worth telling.</p>
    </div>

    <div class="address-column">
      <div class="address-copy">
        <h2>Addres</h2>
        <address>Tripovia Travel &amp; Tour LLC<br />220 Sunset Avenue, Suite 400<br />Los Angeles, CA 90026, United States</address>
      </div>

      <div class="social-block">
        <p>Follow Us</p>
        <div class="social-links">
          <a href="#" aria-label="Follow Tripova on Facebook">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="M13.5 22v-9h3l.45-3.5H13.5V7.27c0-1.01.28-1.7 1.74-1.7H17.1V2.45c-.32-.04-1.43-.14-2.72-.14-2.69 0-4.53 1.64-4.53 4.66V9.5H6.8V13h3.05v9h3.65Z" /></svg>
          </a>
          <a href="#" aria-label="Follow Tripova on Instagram">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
          </a>
          <a href="#" aria-label="Follow Tripova on Twitter">
            <svg viewBox="0 0 24 24" width="20" height="16" fill="currentColor" aria-hidden="true"><path d="M22 5.92c-.74.33-1.54.55-2.38.65a4.15 4.15 0 0 0 1.82-2.29 8.3 8.3 0 0 1-2.63 1A4.14 4.14 0 0 0 11.65 8.1c0 .32.04.64.11.93a11.75 11.75 0 0 1-8.53-4.32 4.14 4.14 0 0 0 1.28 5.52 4.12 4.12 0 0 1-1.88-.52v.05a4.14 4.14 0 0 0 3.32 4.06c-.35.1-.71.14-1.09.14-.27 0-.53-.02-.78-.07a4.14 4.14 0 0 0 3.87 2.88 8.31 8.31 0 0 1-5.14 1.77c-.33 0-.66-.02-.99-.06a11.72 11.72 0 0 0 6.35 1.86c7.62 0 11.79-6.31 11.79-11.79 0-.18 0-.36-.01-.54A8.42 8.42 0 0 0 22 5.92Z" /></svg>
          </a>
        </div>
      </div>
    </div>

    <div class="links-column explore-column">
      <h2>Explore</h2>
      <ul>
        {explore.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>

    <div class="links-column support-column">
      <h2>Support</h2>
      <ul>
        {support.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    width: 100%;
    height: 487px;
    overflow: hidden;
    color: white;
    background: #50635f;
  }

  .footer-content {
    position: relative;
    z-index: 1;
    display: grid;
    width: calc(100% - 84px);
    max-width: 1398px;
    height: 388px;
    margin-inline: auto;
    padding-top: 51px;
    grid-template-columns: repeat(4, minmax(0, 254.25px));
    justify-content: space-between;
    align-items: start;
  }

  .brand-column {
    display: flex;
    width: 254.25px;
    flex-direction: column;
    gap: 23px;
  }

  .brand-name {
    color: white;
    font-family: Caudex, serif;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.25;
  }

  .brand-column p {
    font-family: 'Open Sans', sans-serif;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.5;
  }

  .address-column {
    display: flex;
    width: 254.25px;
    height: 388px;
    flex-direction: column;
    justify-content: space-between;
  }

  .address-copy {
    display: flex;
    flex-direction: column;
    gap: 34px;
  }

  .footer-content h2 {
    color: white;
    font-family: 'Open Sans', sans-serif;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
  }

  .address-copy address,
  .links-column a,
  .social-block > p {
    color: white;
    font-family: 'Open Sans', sans-serif;
    font-size: 15px;
    font-style: normal;
    font-weight: 400;
    line-height: 1.5;
  }

  .links-column ul {
    display: flex;
    flex-direction: column;
  }

  .explore-column ul { margin-top: 25px; gap: 6px; }
  .support-column ul { margin-top: 9px; gap: 4px; }
  .support-column li:nth-child(4) { margin-top: 5px; }
  .support-column li:nth-child(5) { margin-top: 19px; }

  .links-column a { transition: opacity 180ms ease; }
  .links-column a:hover, .links-column a:focus-visible { opacity: 0.7; }

  .social-block {
    display: flex;
    width: 254.25px;
    flex-direction: column;
    gap: 27px;
  }

  .social-links { display: flex; align-items: center; gap: 29px; }

  .social-links a {
    display: grid;
    width: 40px;
    height: 40px;
    place-items: center;
    overflow: hidden;
    border-radius: 50%;
    color: black;
    background: white;
    transition: transform 180ms ease;
  }

  .social-links a:hover, .social-links a:focus-visible { transform: translateY(-3px); }

  .footer-watermark {
    position: absolute;
    top: 307px;
    left: max(calc((100% - 1440px) / 2 + 163px), 80px);
    color: rgb(255 255 255 / 10%);
    font-family: Caudex, serif;
    font-size: 200px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 46px;
    filter: blur(8.5px);
    white-space: nowrap;
    pointer-events: none;
  }

  @media (max-width: 1100px) {
    .site-footer { height: auto; min-height: 487px; }
    .footer-content { width: calc(100% - 64px); height: auto; padding-block: 51px; grid-template-columns: repeat(2, minmax(0, 254.25px)); gap: 56px 80px; justify-content: space-around; }
    .address-column { height: auto; gap: 56px; }
    .footer-watermark { top: auto; bottom: -25px; left: 40px; font-size: 150px; }
  }

  @media (max-width: 639px) {
    .footer-content { width: calc(100% - 48px); grid-template-columns: 1fr; justify-items: start; }
    .brand-column, .address-column, .social-block { width: 100%; }
    .footer-watermark { left: 20px; font-size: 86px; letter-spacing: 22px; }
  }
</style>
