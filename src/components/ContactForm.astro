---
import { Image } from 'astro:assets'
import lakeImg from '../assets/lake.jpg'
---

<section id="contact" class="contact-cta">
  <Image src={lakeImg} alt="Aerial view of a mountain lake" class="background-image" widths={[768, 1024, 1440, 1920]} sizes="100vw" />
  <div class="background-gradient"></div>

  <div class="cta-copy">
    <div class="cta-intro">
      <h2>Not Sure Where to Start? We&apos;ve Got You.</h2>
      <p>Tell us where you want to go, and our travel consultants will craft a plan that fits your style, budget, and schedule &mdash; completely free.</p>
    </div>

    <div class="review-summary">
      <p>from 320+ traveler reviews</p>
      <div class="review-rating" aria-label="Rated 4.9 out of 5">
        <div class="stars">
          {Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 30 30" width="30" height="30" aria-hidden="true"><path d="m15 2.25 3.88 7.85 8.66 1.26-6.27 6.1 1.48 8.63L15 22.02l-7.75 4.07 1.48-8.63-6.27-6.1 8.66-1.26L15 2.25Z" /></svg>
          ))}
        </div>
        <span>4.9/5</span>
      </div>
    </div>
  </div>

  <form class="contact-form">
    <div class="glass-panel">
      <div class="form-field name-field">
        <label for="cta-name">Full Name</label>
        <input id="cta-name" name="name" type="text" autocomplete="name" required placeholder="Jane Smith" />
      </div>

      <div class="form-field email-field">
        <label for="cta-email">Email</label>
        <input id="cta-email" name="email" type="email" autocomplete="email" required placeholder="Jane Smith@Email.com" />
      </div>

      <div class="form-field subject-field">
        <label for="cta-subject">Subject</label>
        <input id="cta-subject" name="subject" type="text" required placeholder="Share With Us" />
      </div>

      <div class="form-field message-field">
        <label for="cta-message">Message</label>
        <textarea id="cta-message" name="message" required placeholder="Share With Us"></textarea>
      </div>
    </div>

    <button type="submit">Submit</button>
  </form>
</section>

<style>
  .contact-cta {
    position: relative;
    display: flex;
    width: 100%;
    height: 653px;
    padding: 87px 57px 67px 88px;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
    overflow: hidden;
  }

  .background-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .background-gradient {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(80 99 95 / 0%) 68%, rgb(80 99 95 / 58%) 86%, #50635f 100%),
      linear-gradient(89deg, rgb(0 0 0 / 50%) 0%, rgb(255 255 255 / 0%) 100%);
  }

  .cta-copy,
  .contact-form {
    position: relative;
    z-index: 1;
  }

  .cta-copy {
    display: flex;
    width: 590px;
    flex: 0 1 590px;
    flex-direction: column;
    align-items: flex-start;
    gap: 98px;
    color: white;
  }

  .cta-intro {
    display: flex;
    width: 100%;
    flex-direction: column;
    gap: 24px;
  }

  .cta-intro h2 {
    width: 539px;
    max-width: 100%;
    color: white;
    font-family: Caudex, serif;
    font-size: 64px;
    font-weight: 700;
    line-height: 64px;
  }

  .cta-intro > p {
    width: 100%;
    color: white;
    font-family: 'Open Sans', sans-serif;
    font-size: 24px;
    font-weight: 400;
    line-height: 30px;
  }

  .review-summary {
    display: flex;
    width: 228px;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }

  .review-summary > p,
  .review-rating > span {
    color: white;
    font-family: 'Open Sans', sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 18px;
  }

  .review-rating { display: inline-flex; align-items: center; gap: 8px; }
  .stars { display: flex; align-items: center; color: #fc9e1b; }
  .stars svg { fill: currentColor; }

  .contact-form {
    display: flex;
    width: 681px;
    max-width: 681px;
    flex: 0 0 681px;
    flex-direction: column;
    align-items: flex-start;
    gap: 23px;
  }

  .glass-panel {
    position: relative;
    width: 100%;
    height: 422px;
    overflow: hidden;
    border-radius: 20px;
    background: rgb(27 27 27 / 30%);
    backdrop-filter: blur(4px);
  }

  .form-field {
    position: absolute;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    border-bottom: 1px solid #dadada;
  }

  .form-field label {
    width: 100%;
    color: white;
    font-family: 'Open Sans', sans-serif;
    font-size: 22px;
    font-weight: 600;
    line-height: 22px;
  }

  .form-field input,
  .form-field textarea {
    width: 100%;
    padding: 0;
    border: 0;
    outline: 0;
    color: #d3d3d3;
    background: transparent;
    font-family: 'Open Sans', sans-serif;
    font-size: 18px;
    font-weight: 400;
    line-height: 18px;
  }

  .form-field input::placeholder,
  .form-field textarea::placeholder { color: #d3d3d3; opacity: 1; }

  .name-field,
  .email-field {
    top: 48px;
    width: 280px;
    padding-block: 10px;
    gap: 20px;
  }

  .name-field { left: 34px; }
  .email-field { left: 368px; }

  .subject-field {
    top: 160px;
    right: 33px;
    left: 35px;
    height: 72px;
    gap: 22px;
  }

  .subject-field input,
  .message-field textarea { font-size: 20px; line-height: 20px; }

  .message-field {
    top: 261px;
    right: 33px;
    left: 35px;
    height: 122px;
    padding-block: 8px;
    gap: 36px;
  }

  .message-field textarea { height: 40px; resize: none; }

  .contact-form > button {
    display: inline-flex;
    width: 100%;
    min-height: 46px;
    padding: 14px 18px;
    align-items: center;
    justify-content: center;
    border-radius: 30px;
    color: #50635f;
    background: white;
    font-family: 'Open Sans', sans-serif;
    font-size: 18px;
    font-weight: 600;
    line-height: 18px;
    transition: color 200ms ease, background-color 200ms ease;
  }

  .contact-form > button:hover,
  .contact-form > button:focus-visible { color: white; background: #50635f; }

  @media (max-width: 1199px) {
    .contact-cta { height: auto; min-height: 653px; padding: 72px 48px; flex-direction: column; justify-content: flex-start; gap: 56px; }
    .cta-copy, .contact-form { width: 100%; flex-basis: auto; }
    .cta-copy { gap: 48px; }
    .contact-form { max-width: 681px; }
  }

  @media (max-width: 639px) {
    .contact-cta { padding: 56px 24px; }
    .cta-intro h2 { font-size: 42px; line-height: 1.05; }
    .cta-intro > p { font-size: 18px; line-height: 1.5; }
    .glass-panel { display: grid; height: auto; padding: 28px 24px; gap: 24px; }
    .form-field, .name-field, .email-field, .subject-field, .message-field { position: static; width: 100%; height: auto; padding-block: 10px; gap: 12px; }
    .form-field label { font-size: 18px; line-height: 1.3; }
    .form-field input, .form-field textarea, .subject-field input, .message-field textarea { height: auto; font-size: 16px; line-height: 1.4; }
  }
</style>
