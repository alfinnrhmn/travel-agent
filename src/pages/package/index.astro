  .ai-message.is-typing i:nth-child(3) { animation-delay: 300ms; }
  .ai-related-products { display: flex; width: min(100%, 520px); margin-top: 14px; flex-direction: column; gap: 8px; white-space: normal; }
  .ai-related-heading { color: #50635f; font: 700 11px/1.4 'Open Sans', sans-serif; letter-spacing: 0.08em; text-transform: uppercase; }
  .ai-related-card { display: grid; min-height: 82px; overflow: hidden; grid-template-columns: 92px minmax(0, 1fr) 34px; align-items: center; border: 1px solid #dfe5e2; border-radius: 12px; color: #2c2c2a; background: #f8faf9; transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease; }
  .ai-related-card:hover { border-color: #50635f; transform: translateY(-1px); box-shadow: 0 8px 22px rgb(48 61 57 / 10%); }
  .ai-related-card img { width: 92px; height: 82px; object-fit: cover; }
  .ai-related-copy { min-width: 0; padding: 10px 12px; }
  .ai-related-copy h4 { overflow: hidden; color: #2c2c2a; font: 700 13px/1.35 'Open Sans', sans-serif; text-overflow: ellipsis; white-space: nowrap; }
