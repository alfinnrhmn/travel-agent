---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

import heroImg from '../assets/Image Hero.jpg'
import baliImg from '../assets/Bali.jpg'
import bromoImg from '../assets/bromo.jpg'
import dubaiImg from '../assets/dubai.jpg'
import indonesiaImg from '../assets/Indonesia.jpg'
import italyImg from '../assets/Italy.jpg'
import italyTwoImg from '../assets/Italy2.jpg'
import japanImg from '../assets/japan.jpg'
import japanTwoImg from '../assets/Japan 2.jpg'
import lakeImg from '../assets/lake.jpg'
import minangImg from '../assets/Minang.jpg'
import peopleImg from '../assets/People.jpg'
import prambananImg from '../assets/Prambanan.jpg'
import rajaAmpatImg from '../assets/Raja ampat.jpg'
import romaImg from '../assets/Roma.jpg'
import teamImg from '../assets/Team.jpg'
import ueaTwoImg from '../assets/UEA2.jpg'
import ueaThreeImg from '../assets/UEA3.jpg'
import testimonialOneImg from '../assets/testimonial 1.jpg'
import testimonialTwoImg from '../assets/testimonial 2.jpg'
import testimonialThreeImg from '../assets/testimonial 3.jpg'

const galleries = [
  {
    id: 'solo',
    number: '01',
    eyebrow: 'Solo Travel',
    title: 'Go Where Curiosity Leads',
    intro: 'Travel at your own pace, from quiet mountains to island horizons.',
    quote: 'Travelling alone gave me the space to notice every small detail — and the confidence to keep going.',
    author: 'Maya Richardson',
    quoteImage: testimonialOneImg,
    items: [
      { image: lakeImg, title: 'Finding Silence in the Mountains', location: 'Lake District' },
      { image: japanImg, title: 'A Slow Walk Through Tokyo', location: 'Japan', video: true },
      { image: bromoImg, title: 'Sunrise Above the Clouds', location: 'Mount Bromo' },
      { image: rajaAmpatImg, title: 'Blue Horizons, New Stories', location: 'Raja Ampat' },
    ],
  },
  {
    id: 'couple',
    number: '02',
    eyebrow: 'Couple Travel',
    title: 'Two Tickets, One Story',
    intro: 'Slow sunsets, shared discoveries, and meaningful escapes for two.',
    quote: 'Every place felt more meaningful because we experienced it side by side. Bali will always be part of our story.',
    author: 'Elena & Marco',
    quoteImage: testimonialTwoImg,
    items: [
      { image: baliImg, title: 'A Romantic Island Escape', location: 'Bali, Indonesia' },
      { image: romaImg, title: 'An Evening Made for Rome', location: 'Rome, Italy' },
      { image: italyImg, title: 'The Coastline We Dreamed Of', location: 'Southern Italy', video: true },
      { image: ueaTwoImg, title: 'Golden Hours in the Emirates', location: 'United Arab Emirates' },
    ],
  },
  {
    id: 'group',
    number: '03',
    eyebrow: 'Group Travel',
    title: 'Better Stories, Shared Together',
    intro: 'Effortless adventures made for friends, laughter, and shared memories.',
    quote: 'The itinerary was seamless, but the best part was how quickly our group felt like one big travelling family.',
    author: 'Kevin Anderson',
    quoteImage: testimonialThreeImg,
    items: [
      { image: teamImg, title: 'A Day Made for Adventure', location: 'Island Expedition', video: true },
      { image: indonesiaImg, title: 'Across the Islands Together', location: 'Indonesia' },
      { image: minangImg, title: 'Culture Around Every Corner', location: 'West Sumatra' },
      { image: prambananImg, title: 'History Shared in Real Time', location: 'Central Java' },
    ],
  },
  {
    id: 'honeymoon',
    number: '04',
    eyebrow: 'Honeymoon',
    title: 'The First Journey of Forever',
    intro: 'Private moments and beautiful places for your first journey together.',
    quote: 'Tripova made every moment feel personal — from the quiet villa mornings to our final sunset by the sea.',
    author: 'Sarah & James',
    quoteImage: peopleImg,
    items: [
      { image: dubaiImg, title: 'Luxury Beyond the Skyline', location: 'Dubai, UAE' },
      { image: italyTwoImg, title: 'A Love Letter to the Coast', location: 'Cinque Terre', video: true },
      { image: japanTwoImg, title: 'Springtime Made for Two', location: 'Japan' },
      { image: ueaThreeImg, title: 'A Private Desert Evening', location: 'Abu Dhabi, UAE' },
    ],
  },
]

---

<Layout
  title="Travel Gallery — Solo, Couple, Group & Honeymoon Trips | Tripova"
  description="Explore Tripova travel stories and destination inspiration for solo journeys, romantic escapes, group adventures, and unforgettable honeymoons."
  image={heroImg}
>
  <Navbar />

  <main>
    <section id="hero" class="gallery-hero" aria-labelledby="gallery-title">
      <Image
        src={heroImg}
        alt="Travellers exploring a beautiful destination"
        class="hero-image"
        widths={[900, 1400, 2000]}
        width={2000}
        sizes="calc(100vw - 44px)"
        quality="high"
        priority
      />
      <div class="hero-overlay"></div>
      <div class="hero-copy">
        <p>Tripova travel journal</p>
        <h1 id="gallery-title">Inspirations for<br />Every Kind of Journey</h1>
        <span>Real places, shared moments, and stories that make you want to pack your bags.</span>
        <a href="#solo">Explore the gallery <b aria-hidden="true">↓</b></a>
      </div>
    </section>

    <nav class="gallery-index" aria-label="Gallery categories">
      {galleries.map((gallery) => <a href={`#${gallery.id}`}>{gallery.eyebrow}</a>)}
    </nav>

    <div class="gallery-sections">
      {galleries.map((gallery, galleryIndex) => (
        <section id={gallery.id} class="story-section" aria-labelledby={`${gallery.id}-title`}>
          <header class="story-heading">
            <div class="heading-title">
              <span>{gallery.number}</span>
              <div>
                <p>{gallery.eyebrow}</p>
                <h2 id={`${gallery.id}-title`}>{gallery.title}</h2>
              </div>
            </div>
            <p class="story-intro">{gallery.intro}</p>
          </header>

          <div class:list={['editorial-grid', { 'is-reversed': galleryIndex % 2 === 1 }]}>
            {gallery.items.map((item, itemIndex) => (
              <article class:list={['travel-card', `travel-card-${itemIndex + 1}`]}>
                <Image
                  src={item.image}
                  alt={item.title}
                  class="travel-image"
                  widths={[480, 720, 1100]}
                  width={1100}
                  sizes="(max-width: 767px) 100vw, (max-width: 1100px) 50vw, 60vw"
                />
                <div class="card-overlay"></div>
                {item.video && (
                  <span class="play-button" aria-label="Video story">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor" aria-hidden="true"><path d="m8 5 11 7-11 7V5Z" /></svg>
                  </span>
                )}
                <div class="travel-copy">
                  <span>{item.location}</span>
                  <h3>{item.title}</h3>
                  <div class="traveller-faces" aria-hidden="true">
                    <Image src={testimonialOneImg} alt="" width={64} quality={82} />
                    <Image src={testimonialTwoImg} alt="" width={64} quality={82} />
                    <Image src={testimonialThreeImg} alt="" width={64} quality={82} />
                  </div>
                </div>
              </article>
            ))}

            <article class="quote-card">
              <Image src={gallery.quoteImage} alt="" class="quote-background" width={800} widths={[480, 800]} sizes="(max-width: 767px) 100vw, 40vw" quality={84} />
              <div class="quote-overlay"></div>
              <div class="quote-copy">
                <p class="quote-label">Traveller note</p>
                <blockquote>“{gallery.quote}”</blockquote>
                <p class="quote-author">— {gallery.author}</p>
              </div>
            </article>
          </div>
        </section>
      ))}
    </div>

  </main>

  <Footer />
</Layout>

<style>
  :global(html) { scroll-behavior: smooth; }

  .gallery-hero {
    --page-gutter: clamp(8px, 1.53vw, 22px);
    position: relative;
    display: grid;
    width: calc(100% - (var(--page-gutter) * 2));
    height: calc(100svh - (var(--page-gutter) * 2));
    min-height: 680px;
    margin: var(--page-gutter) auto 0;
    place-items: center;
    overflow: hidden;
    border-radius: 43px;
    color: white;
    background: #2f3b38;
  }

  .hero-image, .hero-overlay { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero-image { object-fit: cover; object-position: center 58%; }
  .hero-overlay {
    background:
      linear-gradient(180deg, rgb(12 18 16 / 22%) 0%, rgb(12 18 16 / 26%) 38%, rgb(12 18 16 / 72%) 100%),
      linear-gradient(90deg, rgb(12 18 16 / 30%), transparent 55%);
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100% - 48px, 920px);
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .hero-copy > p {
    margin-bottom: 18px;
    font: 600 13px/1.3 'Open Sans', sans-serif;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .hero-copy h1 {
    font-family: Caudex, serif;
    font-size: clamp(50px, 6vw, 86px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.035em;
  }

  .hero-copy > span {
    width: min(100%, 650px);
    margin-top: 24px;
    color: rgb(255 255 255 / 82%);
    font: 400 clamp(17px, 1.667vw, 24px)/1.5 'Open Sans', sans-serif;
  }

  .hero-copy a {
    display: inline-flex;
    align-items: center;
    gap: 20px;
    margin-top: 34px;
    padding: 13px 18px 13px 22px;
    border-radius: 999px;
    color: #2c2c2a;
    background: white;
    font: 600 14px/1 'Open Sans', sans-serif;
    transition: transform 180ms ease, background-color 180ms ease;
  }

  .hero-copy a b {
    display: grid;
    width: 32px;
    height: 32px;
    place-items: center;
    border-radius: 50%;
    color: white;
    background: #50635f;
  }

  .hero-copy a:hover { transform: translateY(-3px); background: #f3f1e6; }

  .gallery-index {
    position: sticky;
    z-index: 10;
    top: 78px;
    display: flex;
    width: fit-content;
    max-width: calc(100% - 32px);
    margin: 38px auto 0;
    padding: 7px;
    gap: 4px;
    overflow-x: auto;
    border: 1px solid #e3e6e5;
    border-radius: 999px;
    background: rgb(255 255 255 / 92%);
    box-shadow: 0 14px 34px rgb(44 44 42 / 8%);
    backdrop-filter: blur(10px);
  }

  .gallery-index a {
    flex: none;
    padding: 10px 18px;
    border-radius: 999px;
    color: #626663;
    font: 600 13px/1 'Open Sans', sans-serif;
    transition: color 180ms ease, background-color 180ms ease;
  }

  .gallery-index a:hover { color: white; background: #50635f; }

  .gallery-sections {
    display: flex;
    width: min(calc(100% - 44px), 1396px);
    margin: 144px auto;
    flex-direction: column;
    gap: 144px;
  }

  .story-section { scroll-margin-top: 150px; }
  .story-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 48px;
    margin-bottom: 52px;
  }

  .heading-title { display: flex; align-items: flex-start; gap: 22px; }
  .heading-title > span {
    margin-top: 8px;
    color: #a3aaa7;
    font: 600 13px/1 'Open Sans', sans-serif;
    letter-spacing: 0.12em;
  }

  .heading-title p {
    margin-bottom: 7px;
    color: #50635f;
    font: 600 13px/1.3 'Open Sans', sans-serif;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .heading-title h2 {
    color: #2c2c2a;
    font-family: Caudex, serif;
    font-size: clamp(38px, 4vw, 54px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.025em;
  }

  .story-intro {
    width: min(100%, 440px);
    color: #696d6a;
    font: 400 20px/1.55 'Open Sans', sans-serif;
    text-align: right;
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows:
      clamp(330px, 31.67vw, 456px)
      clamp(438px, 41.94vw, 604px);
    gap: 14px;
  }

  .travel-card, .quote-card {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    background: #34423e;
    isolation: isolate;
  }

  .travel-card-1 { grid-column: span 8; grid-row: span 1; }
  .travel-card-2, .travel-card-3, .travel-card-4, .quote-card { grid-column: span 4; grid-row: span 1; }
  .editorial-grid.is-reversed .travel-card-1 { grid-column: 5 / span 8; }
  .editorial-grid.is-reversed .travel-card-2 { grid-column: 1 / span 4; grid-row: 1; }
  .editorial-grid.is-reversed .travel-card-3 { grid-column: 1 / span 4; grid-row: 2; }
  .editorial-grid.is-reversed .travel-card-4 { grid-column: 5 / span 4; grid-row: 2; }
  .editorial-grid.is-reversed .quote-card { grid-column: 9 / span 4; grid-row: 2; }

  .travel-image, .quote-background, .card-overlay, .quote-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .travel-image, .quote-background {
    object-fit: cover;
    transition: transform 650ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .travel-card:hover .travel-image { transform: scale(1.055); }
  .card-overlay { background: linear-gradient(0deg, rgb(8 13 11 / 78%) 0%, transparent 68%); }
  .quote-overlay { background: rgb(24 31 29 / 84%); }

  .travel-copy {
    position: absolute;
    z-index: 1;
    right: 24px;
    bottom: 22px;
    left: 24px;
    color: white;
  }

  .travel-copy > span {
    color: rgb(255 255 255 / 74%);
    font: 600 10px/1.3 'Open Sans', sans-serif;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .travel-copy h3 {
    width: min(100%, 520px);
    margin-top: 7px;
    font: 700 clamp(22px, 2.1vw, 30px)/1.15 Caudex, serif;
  }

  .traveller-faces { display: flex; margin-top: 14px; padding-left: 7px; }
  .traveller-faces :global(img) {
    width: 27px;
    height: 27px;
    margin-left: -7px;
    object-fit: cover;
    border: 2px solid white;
    border-radius: 50%;
  }

  .play-button {
    position: absolute;
    z-index: 2;
    top: 18px;
    left: 18px;
    display: grid;
    width: 42px;
    height: 42px;
    place-items: center;
    border: 1px solid rgb(255 255 255 / 75%);
    border-radius: 50%;
    color: white;
    background: rgb(80 99 95 / 25%);
    backdrop-filter: blur(4px);
  }

  .play-button svg { margin-left: 2px; }
  .quote-copy {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    padding: 30px;
    flex-direction: column;
    justify-content: center;
    color: white;
    text-align: center;
  }

  .quote-label {
    margin-bottom: 16px;
    color: #d8dfdc;
    font: 600 10px/1.2 'Open Sans', sans-serif;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .quote-copy blockquote { font: 700 23px/1.4 Caudex, serif; }
  .quote-author { margin-top: 18px; color: rgb(255 255 255 / 72%); font: 500 12px/1.4 'Open Sans', sans-serif; }

  @media (max-width: 1023px) {
    .gallery-sections { width: min(calc(100% - 40px), 900px); }
    .story-heading { align-items: flex-start; flex-direction: column; gap: 22px; }
    .story-intro { width: min(100%, 620px); text-align: left; }
    .editorial-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: 360px 430px 430px; }
    .travel-card-1, .editorial-grid.is-reversed .travel-card-1 { grid-column: 1 / -1; grid-row: 1; }
    .travel-card-2, .editorial-grid.is-reversed .travel-card-2 { grid-column: 1; grid-row: 2; }
    .travel-card-3, .editorial-grid.is-reversed .travel-card-3 { grid-column: 2; grid-row: 2; }
    .travel-card-4, .editorial-grid.is-reversed .travel-card-4 { grid-column: 1; grid-row: 3; }
    .quote-card, .editorial-grid.is-reversed .quote-card { grid-column: 2; grid-row: 3; }
  }

  @media (max-width: 767px) {
    .gallery-hero { min-height: 680px; border-radius: 28px; }
    .hero-copy { width: calc(100% - 36px); }
    .hero-copy h1 { font-size: clamp(42px, 13vw, 62px); }
    .hero-copy > span { font-size: 17px; }
    .gallery-index { top: 68px; justify-content: flex-start; }
    .gallery-sections { width: calc(100% - 32px); margin-block: 104px; gap: 104px; }
    .story-heading { margin-bottom: 36px; }
    .heading-title { gap: 12px; }
    .heading-title h2 { font-size: 37px; }
    .story-intro { font-size: 17px; }
    .editorial-grid { display: flex; flex-direction: column; }
    .travel-card, .quote-card { width: 100%; height: auto; flex: none; aspect-ratio: 3 / 4; }
    .travel-card-1 { aspect-ratio: 16 / 10; }
    .travel-card-2 { aspect-ratio: 1 / 1; }
    .travel-copy { right: 20px; bottom: 20px; left: 20px; }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html) { scroll-behavior: auto; }
    .travel-image, .hero-copy a { transition: none; }
  }
</style>
