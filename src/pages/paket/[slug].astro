---
import Layout from '../../layouts/Layout.astro'
import Navbar from '../../components/Navbar.astro'
import Footer from '../../components/Footer.astro'
import PackageCard from '../../components/PackageCard.astro'
import { Image } from 'astro:assets'
import packagesData from '../../data/packages.json'

import dubaiImg from '../../assets/dubai.jpg'
import baliImg from '../../assets/Bali.jpg'
import romaImg from '../../assets/Roma.jpg'
import japanImg from '../../assets/japan.jpg'
import bannerImg from '../../assets/Banner Produck detail page.jpg'
import peopleImg from '../../assets/People.jpg'

const imageMap: Record<string, ImageMetadata> = {
  'dubai.jpg': dubaiImg,
  'Bali.jpg': baliImg,
  'Roma.jpg': romaImg,
  'japan.jpg': japanImg,
  'Banner Produck detail page.jpg': bannerImg,
  'People.jpg': peopleImg,
}

export function getStaticPaths() {
  return packagesData.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg },
  }))
}

const { pkg } = Astro.props
const recommended = packagesData.slice(0, 4)
---

<Layout
  title={`${pkg.name} — Tripova`}
  description={pkg.description}
  image={imageMap[pkg.gallery[0]].src}
  type="article"
  noindex
>
  <Navbar />

  <main class="mx-auto max-w-[1402px] px-6 pb-10 pt-28">
    <!-- Gallery -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <div class="md:col-span-2 relative rounded-2xl overflow-hidden h-80">
        {pkg.badge && (
          <span class="absolute top-4 left-4 z-10 bg-red-600 text-white text-xs font-body px-3 py-1 rounded-full">
            {pkg.badge}
          </span>
        )}
        <Image src={imageMap[pkg.gallery[0]]} alt={pkg.name} class="w-full h-full object-cover" />
      </div>
      <div class="rounded-2xl overflow-hidden h-80">
        <Image src={imageMap[pkg.gallery[1] ?? pkg.gallery[0]]} alt={pkg.name} class="w-full h-full object-cover" />
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
      <!-- Left column -->
      <div class="lg:col-span-2">
        <h1 class="font-heading text-3xl text-[#2C2C2A]">{pkg.name}</h1>
        <p class="font-body text-sm text-[#5B5B58] mt-1">{pkg.location}</p>
        <p class="font-body text-sm mt-2">
          <span class="text-amber-500">{'★'.repeat(Math.round(pkg.rating))}</span>
          <span class="text-[#2C2C2A]">{pkg.rating.toFixed(1)}</span>
          <span class="text-[#5B5B58]"> · {pkg.reviewCount} Reviews · {pkg.duration}</span>
        </p>

        <hr class="my-6 border-black/10" />

        <h2 class="font-heading text-xl text-[#2C2C2A] mb-2">Description</h2>
        <p class="font-body text-sm text-[#5B5B58] leading-relaxed">{pkg.description}</p>

        <h2 class="font-heading text-xl text-[#2C2C2A] mt-8 mb-4">Itinerary</h2>
        <div class="space-y-3">
          {pkg.itinerary.map((day, i) => (
            <details class="border border-black/10 rounded-xl px-4 py-3" open={i === 0}>
              <summary class="font-body font-semibold text-sm cursor-pointer text-[#2C2C2A]">
                {day.day}
              </summary>
              <ul class="mt-3 space-y-1 font-body text-sm text-[#5B5B58] list-disc list-inside">
                {day.activities.map((act) => <li>{act}</li>)}
              </ul>
            </details>
          ))}
        </div>

        <h2 class="font-heading text-xl text-[#2C2C2A] mt-8 mb-4">Inclusions and exclusions</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <p class="font-body font-semibold text-green-700 mb-2">Included</p>
            <ul class="font-body text-sm text-[#2C2C2A] space-y-1">
                {pkg.included.map((item) => (
                  <li class="legacy-inclusion-item">
                    <span class="legacy-included-icon" aria-hidden="true">✔</span>
                    <span>{item}</span>
                  </li>
                ))}
            </ul>
          </div>
          <div>
            <p class="font-body font-semibold text-red-600 mb-2">Not Included</p>
            <ul class="font-body text-sm text-[#2C2C2A] space-y-1">
                {pkg.notIncluded.map((item) => (
                  <li class="legacy-inclusion-item">
                    <span class="legacy-excluded-icon" aria-hidden="true">✘</span>
                    <span>{item}</span>
                  </li>
                ))}
            </ul>
          </div>
        </div>
      </div>

      <!-- Right column: Booking sidebar -->
      <aside class="border border-black/10 rounded-2xl p-6 h-fit sticky top-6">
        <p class="font-body text-xs text-[#5B5B58]">Starting From</p>
        <p class="font-heading text-3xl text-primary">${pkg.price} <span class="text-sm font-body text-[#5B5B58]">/ person</span></p>

        <form class="mt-5 space-y-3">
          <div>
            <label class="font-body text-xs text-[#5B5B58]">Name</label>
            <input type="text" placeholder="Full Name" class="w-full border border-black/10 rounded-lg px-3 py-2 text-sm font-body mt-1" />
          </div>
          <div>
            <label class="font-body text-xs text-[#5B5B58]">Email</label>
            <input type="email" placeholder="Email@Mail.com" class="w-full border border-black/10 rounded-lg px-3 py-2 text-sm font-body mt-1" />
          </div>
          <div>
            <label class="font-body text-xs text-[#5B5B58]">Number</label>
            <input type="tel" placeholder="081xxxxxxxxxx" class="w-full border border-black/10 rounded-lg px-3 py-2 text-sm font-body mt-1" />
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="font-body text-xs text-[#5B5B58]">Date</label>
              <input type="date" class="w-full border border-black/10 rounded-lg px-3 py-2 text-sm font-body mt-1" />
            </div>
            <div>
              <label class="font-body text-xs text-[#5B5B58]">People</label>
              <input type="number" min="1" value="1" class="w-full border border-black/10 rounded-lg px-3 py-2 text-sm font-body mt-1" />
            </div>
          </div>
          <div>
            <label class="font-body text-xs text-[#5B5B58]">Notes</label>
            <textarea placeholder="Notes" rows="2" class="w-full border border-black/10 rounded-lg px-3 py-2 text-sm font-body mt-1 resize-none"></textarea>
          </div>

          <button type="submit" class="w-full bg-primary text-white rounded-full py-3 font-body font-semibold mt-2 hover:bg-primary/90 transition-colors">
            Book Now
          </button>
          <a
            href={`https://wa.me/?text=${encodeURIComponent('Halo, saya ingin tanya tentang paket ' + pkg.name)}`}
            target="_blank"
            class="block text-center w-full border border-primary text-primary rounded-full py-3 font-body font-semibold hover:bg-primary/5 transition-colors"
          >
            Quick Chat
          </a>
        </form>

        <p class="font-body text-xs text-[#5B5B58] mt-4">
          ✔ Free cancellation up to 24 hours before departure
        </p>
      </aside>
    </div>

    <!-- Recommended -->
    <section class="recommended-section">
      <h2 class="recommended-title">Recommended For You</h2>
      <div class="recommended-grid">
        {recommended.map((rec) => (
          <PackageCard
            slug={rec.slug}
            name={rec.name}
            location={rec.location}
            duration={rec.duration}
            price={rec.price}
            rating={rec.rating}
            image={imageMap[rec.image]}
          />
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .legacy-inclusion-item {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .legacy-included-icon {
    color: #169c46 !important;
    font-weight: 700;
  }

  .legacy-excluded-icon {
    color: #e03131 !important;
    font-weight: 700;
  }

  .recommended-section {
    display: flex;
    width: 100%;
    margin-top: 64px;
    flex-direction: column;
    align-items: flex-start;
    gap: 38px;
  }

  .recommended-title {
    width: 100%;
    color: black;
    font-family: 'Open Sans', sans-serif;
    font-size: 26px;
    font-weight: 600;
    line-height: 1.35;
  }

  .recommended-grid {
    display: grid;
    width: 100%;
    grid-template-columns: repeat(4, minmax(0, 325px));
    align-items: center;
    justify-content: start;
    gap: 18px;
    background: white;
  }

  @media (max-width: 1199px) {
    .recommended-grid {
      grid-template-columns: repeat(2, minmax(0, 325px));
      justify-content: center;
    }
  }

  @media (max-width: 699px) {
    .recommended-section { align-items: center; }
    .recommended-grid { grid-template-columns: minmax(0, 325px); }
  }
</style>
