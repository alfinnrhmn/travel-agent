---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'

import heroImg from '../assets/Image Hero.jpg'
import peopleImg from '../assets/People.jpg'
import teamImg from '../assets/Team.jpg'
import indonesiaImg from '../assets/Indonesia.jpg'
import rajaAmpatImg from '../assets/Raja ampat.jpg'

const values = [
  {
    title: 'Personal by Design',
    text: 'Every itinerary begins with you — your pace, interests, comfort, and the moments you want to remember.',
    icon: 'route',
  },
  {
    title: 'Local at Heart',
    text: 'We work with trusted local guides and partners who understand every destination beyond the familiar highlights.',
    icon: 'people',
  },
  {
    title: 'Simple from Start to Finish',
    text: 'Clear prices, thoughtful planning, and responsive support make the journey feel effortless before it even begins.',
    icon: 'check',
  },
]

const stats = [
  { value: '12+', label: 'Years crafting journeys' },
  { value: '48', label: 'Destinations explored' },
  { value: '8.5K+', label: 'Traveller stories' },
  { value: '4.9/5', label: 'Average traveller rating' },
]
---

<Layout
  title="About Tripova — Personal Travel Planning"
  description="Meet Tripova and discover how we create thoughtful, personalized journeys through trusted local knowledge and travel planning shaped around you."
  image={heroImg}
>
  <Navbar alwaysSolid />

  <main>
    <section id="hero" class="about-hero" aria-labelledby="about-title">
      <div class="hero-shell">
        <div class="hero-feature">
            <Image
              src={heroImg}
              alt="A personal journey designed by Tripova"
              widths={[720, 1100, 1500]}
              width={1500}
              sizes="(max-width: 767px) 100vw, 58vw"
              quality="high"
              priority
            />
        </div>

        <div class="hero-title-block">
          <h1 id="about-title">Journeys feel better <span>when they feel like yours.</span></h1>
        </div>
      </div>
    </section>

    <section class="about-intro" aria-labelledby="intro-title">
      <p>Meet Tripova</p>
      <h2 id="intro-title"><span>Not Just Another</span> Travel Company</h2>
      <div class="intro-line"></div>
      <p class="intro-copy">
        We believe the best journeys are not the busiest or the most expensive. They are the ones that understand who you are, leave space for discovery, and make every detail feel naturally yours.
      </p>
    </section>

    <section id="our-story" class="story-section" aria-labelledby="story-title">
      <div class="story-visuals">
        <Image src={peopleImg} alt="Travellers planning their route together" class="story-image-main" width={700} widths={[420, 700]} sizes="(max-width: 1023px) 55vw, 32vw" quality={84} />
        <div class="story-image-secondary">
          <Image src={teamImg} alt="A group enjoying a boat trip" width={640} widths={[360, 640]} sizes="(max-width: 1023px) 45vw, 26vw" quality={84} />
          <span class="play-mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="currentColor"><path d="m8 5 11 7-11 7V5Z" /></svg>
          </span>
        </div>
      </div>

      <div class="story-copy">
        <p class="eyebrow">Where it began</p>
        <h2 id="story-title"><span>Built from a Love of Places.</span><br />Shaped Around People.</h2>
        <p>
          Tripova started with a simple frustration: too many trips looked perfect on paper but felt generic in real life. We wanted travel to feel warmer, more thoughtful, and more connected to the people taking the journey.
        </p>
        <p>
          Today, we bring together destination knowledge, trusted local partnerships, and genuinely personal planning. The result is not a template with your name added — it is a story designed around how you actually want to travel.
        </p>
        <div class="signature">
          <strong>One journey. Your pace. Your story.</strong>
          <span>— The Tripova Team</span>
        </div>
      </div>
    </section>

    <section class="stats-section" aria-label="Tripova in numbers">
      {stats.map((stat) => (
        <div class="stat">
          <strong>{stat.value}</strong>
          <span>{stat.label}</span>
        </div>
      ))}
    </section>

    <section class="values-section" aria-labelledby="values-title">
      <header class="section-heading">
        <div>
          <p>What guides us</p>
          <h2 id="values-title"><span>Thoughtful Travel,</span><br />Made Human</h2>
        </div>
        <p>These principles shape every recommendation, partnership, and itinerary we create.</p>
      </header>

      <div class="values-grid">
        {values.map((value, index) => (
          <article class="value-card">
            <div class="value-number">0{index + 1}</div>
            <span class="value-icon" aria-hidden="true">
              {value.icon === 'route' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="6" cy="19" r="2" /><circle cx="18" cy="5" r="2" /><path d="M8 19c6 0 2-14 8-14" /></svg>
              )}
              {value.icon === 'people' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="9" cy="8" r="3" /><circle cx="17" cy="9" r="2.2" /><path d="M3.5 19c.5-4 2.4-6 5.5-6s5 2 5.5 6M15 14c3 0 4.5 1.7 5 4.5" /></svg>
              )}
              {value.icon === 'check' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="9" /><path d="m8 12 2.6 2.6L16.5 9" /></svg>
              )}
            </span>
            <h3>{value.title}</h3>
            <p>{value.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="difference-section" aria-labelledby="difference-title">
      <div class="difference-image">
        <Image src={indonesiaImg} alt="An authentic local travel experience in Indonesia" width={1100} widths={[720, 1100]} sizes="(max-width: 1023px) 100vw, 54vw" quality={84} />
        <div class="image-badge">
          <strong>100%</strong>
          <span>Made around you</span>
        </div>
      </div>

      <div class="difference-copy">
        <p class="eyebrow">The Tripova difference</p>
        <h2 id="difference-title"><span>Less Guesswork.</span><br />More Meaningful Moments.</h2>
        <p class="difference-intro">
          We take care of the moving parts without taking away the freedom that makes travel exciting.
        </p>
        <ul>
          <li><span>✓</span><div><strong>Real conversations first</strong><p>We listen before recommending a single destination.</p></div></li>
          <li><span>✓</span><div><strong>Carefully chosen partners</strong><p>Every stay, guide, and experience is selected with intention.</p></div></li>
          <li><span>✓</span><div><strong>Support that travels with you</strong><p>Helpful, human assistance before, during, and after your trip.</p></div></li>
        </ul>
        <a href="/package/">Explore our packages <b aria-hidden="true">→</b></a>
      </div>
    </section>

    <section class="about-cta" aria-labelledby="cta-title">
      <Image src={rajaAmpatImg} alt="A tropical island ready to be explored" class="cta-image" width={2000} widths={[900, 1400, 2000]} sizes="calc(100vw - 44px)" quality={84} />
      <div class="cta-shade"></div>
      <div class="cta-copy">
        <p>Your next story starts here</p>
        <h2 id="cta-title">Where Will Your Story Take You?</h2>
        <span>Tell us what inspires you. We will turn it into a journey that feels unmistakably yours.</span>
        <div class="cta-actions">
          <a href="/package/">Find your package</a>
          <a href="/contact" class="secondary">Talk to a consultant</a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .about-hero {
    --page-gutter: clamp(8px, 1.53vw, 22px);
    position: relative;
    width: calc(100% - (var(--page-gutter) * 2));
    height: min(780px, calc(100svh - 112px));
    min-height: 650px;
    margin: 88px auto 0;
    overflow: hidden;
    border-radius: 43px;
    color: #2c2c2a;
    background: #f3f4f0;
  }

  .hero-shell {
    display: grid;
    width: 100%;
    max-width: 1396px;
    height: 100%;
    margin-inline: auto;
    padding: 28px;
    grid-template-columns: minmax(0, 1.14fr) minmax(350px, .86fr);
    align-items: stretch;
    gap: clamp(34px, 5vw, 82px);
  }

  .hero-feature {
    position: relative;
    min-width: 0;
    height: 100%;
    overflow: hidden;
    border-radius: 20px;
    background: #50635f;
  }

  .hero-feature :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms cubic-bezier(.22, 1, .36, 1);
  }

  .hero-feature:hover :global(img) { transform: scale(1.035); }

  .hero-title-block {
    display: flex;
    align-items: center;
    padding-right: clamp(12px, 3vw, 48px);
  }

  .hero-title-block h1 {
    max-width: 570px;
    color: #2c2c2a;
    font: 700 clamp(50px, 5.1vw, 74px)/1.06 Caudex, serif;
    letter-spacing: -0.035em;
  }

  .hero-title-block h1 span { color: #92948f; font-weight: 400; }

  .eyebrow, .section-heading > div > p, .cta-copy > p {
    margin-bottom: 14px;
    font: 600 12px/1.3 'Open Sans', sans-serif;
    letter-spacing: 0.19em;
    text-transform: uppercase;
  }

  .about-intro {
    display: flex;
    width: min(calc(100% - 40px), 880px);
    margin: 144px auto;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .about-intro > p:first-child, .section-heading > div > p, .eyebrow { color: #50635f; }
  .about-intro h2 {
    color: #50635f;
    font: 700 clamp(42px, 4.5vw, 60px)/1.08 Caudex, serif;
    letter-spacing: -0.025em;
  }

  .about-intro h2 span, .story-copy h2 span, .section-heading h2 span, .difference-copy h2 span { color: #919191; }
  .intro-line { width: 1px; height: 64px; margin: 28px 0; background: #cdd3d0; }
  .intro-copy { max-width: 740px; color: #5f625f; font: 400 17px/1.8 'Open Sans', sans-serif; }

  .story-section {
    display: grid;
    width: min(calc(100% - 44px), 1354px);
    margin: 0 auto 144px;
    grid-template-columns: minmax(0, 760px) minmax(380px, 1fr);
    align-items: center;
    gap: clamp(44px, 5vw, 80px);
  }

  .story-visuals { display: flex; align-items: flex-start; gap: 13px; }
  .story-image-main { width: 55%; height: 634px; object-fit: cover; border-radius: 20px; }
  .story-image-secondary {
    position: relative;
    width: 45%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: 20px;
  }

  .story-image-secondary :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .story-image-secondary::after { position: absolute; inset: 0; content: ''; background: rgb(0 0 0 / 13%); }
  .play-mark {
    position: absolute;
    z-index: 2;
    top: 50%;
    left: 50%;
    display: grid;
    width: 58px;
    height: 58px;
    place-items: center;
    transform: translate(-50%, -50%);
    border: 1px solid rgb(255 255 255 / 76%);
    border-radius: 50%;
    color: white;
    backdrop-filter: blur(3px);
  }

  .play-mark svg { margin-left: 3px; }
  .story-copy h2, .difference-copy h2 {
    color: #50635f;
    font: 700 clamp(40px, 4vw, 54px)/1.08 Caudex, serif;
    letter-spacing: -0.025em;
  }

  .story-copy > p:not(.eyebrow) {
    margin-top: 23px;
    color: #5f625f;
    font: 400 15px/1.75 'Open Sans', sans-serif;
  }

  .signature { display: flex; margin-top: 32px; flex-direction: column; gap: 6px; font-family: 'Open Sans', sans-serif; }
  .signature strong { color: #50635f; font-size: 16px; }
  .signature span { color: #969995; font-size: 13px; }

  .stats-section {
    display: grid;
    width: min(calc(100% - 44px), 1396px);
    margin: 0 auto 144px;
    padding: 58px 72px;
    grid-template-columns: repeat(4, 1fr);
    border-radius: 20px;
    color: white;
    background: #50635f;
  }

  .stat { display: flex; min-height: 92px; flex-direction: column; align-items: center; justify-content: center; border-right: 1px solid rgb(255 255 255 / 19%); text-align: center; }
  .stat:last-child { border-right: 0; }
  .stat strong { font: 700 46px/1 Caudex, serif; }
  .stat span { margin-top: 11px; color: rgb(255 255 255 / 72%); font: 400 13px/1.4 'Open Sans', sans-serif; }

  .values-section { width: min(calc(100% - 44px), 1280px); margin: 0 auto 144px; }
  .section-heading { display: flex; align-items: flex-end; justify-content: space-between; gap: 48px; margin-bottom: 54px; }
  .section-heading h2 { color: #50635f; font: 700 clamp(42px, 4.2vw, 58px)/1.06 Caudex, serif; }
  .section-heading > p { width: min(100%, 430px); color: #696d6a; font: 400 15px/1.7 'Open Sans', sans-serif; text-align: right; }
  .values-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  .value-card {
    position: relative;
    min-height: 370px;
    padding: 34px;
    overflow: hidden;
    border: 1px solid #dfe4e1;
    border-radius: 20px;
    background: #f6f7f3;
    transition: color 250ms ease, background-color 250ms ease, transform 250ms ease;
  }

  .value-card:hover { color: white; background: #50635f; transform: translateY(-7px); }
  .value-number { position: absolute; top: 28px; right: 30px; color: #b3bab7; font: 600 12px/1 'Open Sans', sans-serif; letter-spacing: .12em; }
  .value-icon { display: grid; width: 58px; height: 58px; margin-top: 68px; place-items: center; border-radius: 50%; color: white; background: #50635f; }
  .value-icon svg { width: 27px; height: 27px; }
  .value-card:hover .value-icon { color: #50635f; background: white; }
  .value-card h3 { margin-top: 29px; color: #50635f; font: 700 25px/1.2 Caudex, serif; }
  .value-card p { margin-top: 13px; color: #646965; font: 400 14px/1.7 'Open Sans', sans-serif; }
  .value-card:hover h3, .value-card:hover p { color: white; }

  .difference-section {
    display: grid;
    width: min(calc(100% - 44px), 1280px);
    margin: 0 auto 144px;
    grid-template-columns: 1.08fr .92fr;
    align-items: center;
    gap: clamp(48px, 6vw, 92px);
  }

  .difference-image { position: relative; height: 660px; overflow: hidden; border-radius: 20px; }
  .difference-image :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .image-badge {
    position: absolute;
    right: 22px;
    bottom: 22px;
    display: flex;
    width: 150px;
    height: 150px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: white;
    background: rgb(80 99 95 / 88%);
    backdrop-filter: blur(5px);
  }

  .image-badge strong { font: 700 31px/1 Caudex, serif; }
  .image-badge span { margin-top: 8px; font: 500 11px/1.3 'Open Sans', sans-serif; }
  .difference-intro { margin-top: 22px; color: #5f625f; font: 400 16px/1.75 'Open Sans', sans-serif; }
  .difference-copy ul { display: flex; margin-top: 30px; flex-direction: column; gap: 23px; }
  .difference-copy li { display: flex; align-items: flex-start; gap: 15px; }
  .difference-copy li > span { display: grid; width: 30px; height: 30px; flex: none; place-items: center; border-radius: 50%; color: white; background: #50635f; font: 700 13px/1 'Open Sans', sans-serif; }
  .difference-copy li strong { color: #2c2c2a; font: 600 16px/1.3 'Open Sans', sans-serif; }
  .difference-copy li p { margin-top: 4px; color: #777b77; font: 400 13px/1.55 'Open Sans', sans-serif; }
  .difference-copy > a { display: inline-flex; align-items: center; gap: 24px; margin-top: 34px; padding: 14px 20px; border: 1px solid #50635f; border-radius: 999px; color: #50635f; font: 600 14px/1 'Open Sans', sans-serif; transition: color 180ms ease, background-color 180ms ease; }
  .difference-copy > a:hover { color: white; background: #50635f; }

  .about-cta {
    position: relative;
    display: grid;
    width: 100%;
    height: 600px;
    min-height: 600px;
    margin: 0;
    place-items: center;
    overflow: hidden;
    border-radius: 0;
    color: white;
  }

  .cta-image, .cta-shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .cta-image { object-fit: cover; }
  .cta-shade {
    background:
      linear-gradient(180deg, rgb(80 99 95 / 0%) 66%, rgb(80 99 95 / 58%) 85%, #50635f 100%),
      linear-gradient(90deg, rgb(10 17 15 / 75%), rgb(10 17 15 / 34%)),
      linear-gradient(0deg, rgb(10 17 15 / 56%), transparent 62%);
  }
  .cta-copy { position: relative; z-index: 1; display: flex; width: min(calc(100% - 40px), 820px); flex-direction: column; align-items: center; text-align: center; }
  .cta-copy h2 { font: 700 clamp(44px, 5vw, 68px)/1.05 Caudex, serif; }
  .cta-copy > span { width: min(100%, 620px); margin-top: 18px; color: rgb(255 255 255 / 82%); font: 400 16px/1.65 'Open Sans', sans-serif; }
  .cta-actions { display: flex; margin-top: 31px; gap: 12px; }
  .cta-actions a { padding: 15px 23px; border: 1px solid white; border-radius: 999px; color: #50635f; background: white; font: 600 13px/1 'Open Sans', sans-serif; }
  .cta-actions .secondary { color: white; background: transparent; }

  @media (max-width: 1023px) {
    .about-hero { height: min(720px, calc(100svh - 104px)); min-height: 600px; }
    .hero-shell { padding: 24px; grid-template-columns: minmax(0, 1.05fr) minmax(300px, .95fr); gap: 38px; }
    .hero-title-block { padding-right: 16px; }
    .hero-title-block h1 { font-size: clamp(44px, 6vw, 58px); }
    .story-section { grid-template-columns: 1fr; }
    .story-visuals { max-width: 760px; margin-inline: auto; }
    .story-copy { max-width: 720px; margin-inline: auto; }
    .stats-section { padding-inline: 30px; }
    .values-grid { grid-template-columns: 1fr; }
    .value-card { min-height: 290px; }
    .value-icon { margin-top: 36px; }
    .difference-section { grid-template-columns: 1fr; }
    .difference-image { height: 580px; }
  }

  @media (max-width: 767px) {
    .about-hero { height: auto; min-height: 0; margin-top: 76px; border-radius: 28px; background: #f3f4f0; }
    .hero-shell { display: flex; height: auto; min-height: 0; padding: 16px; flex-direction: column; gap: 30px; }
    .hero-title-block { order: -1; padding: 26px 8px 0; }
    .hero-title-block h1 { font-size: clamp(40px, 12vw, 54px); }
    .hero-feature { width: 100%; height: 470px; min-height: 0; border-radius: 16px; }
    .promise-body p { font-size: 12px; line-height: 1.55; }
    .promise-body a { font-size: 12px; gap: 9px; }
    .promise-body a b { width: 34px; height: 34px; }
    .about-intro { margin-block: 104px; }
    .story-section, .values-section, .difference-section { width: calc(100% - 32px); margin-bottom: 104px; }
    .story-visuals { gap: 8px; }
    .story-image-main { height: 460px; }
    .story-image-main, .story-image-secondary { border-radius: 16px; }
    .story-copy h2, .difference-copy h2 { font-size: 38px; }
    .stats-section { width: calc(100% - 32px); margin-bottom: 104px; padding: 20px; grid-template-columns: repeat(2, 1fr); }
    .stat { min-height: 140px; border-bottom: 1px solid rgb(255 255 255 / 19%); }
    .stat:nth-child(2) { border-right: 0; }
    .stat:nth-child(3), .stat:nth-child(4) { border-bottom: 0; }
    .stat strong { font-size: 37px; }
    .section-heading { align-items: flex-start; flex-direction: column; gap: 20px; margin-bottom: 38px; }
    .section-heading > p { width: 100%; text-align: left; }
    .difference-image { height: 480px; }
    .about-cta { height: auto; min-height: 600px; }
    .cta-actions { width: 100%; flex-direction: column; }
    .cta-actions a { width: 100%; text-align: center; }
  }
</style>
