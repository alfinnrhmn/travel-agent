---
import { Image } from 'astro:assets'
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import Footer from '../components/Footer.astro'
import lakeImg from '../assets/lake.jpg'
---

<Layout title="Contact Us — Tripova">
  <Navbar />

  <main class="px-2 pt-20 sm:px-3 sm:pt-24">
    <section class="relative mx-auto min-h-[360px] max-w-[1400px] overflow-hidden rounded-[1.6rem] sm:min-h-[430px]">
      <Image
        src={lakeImg}
        alt="A peaceful mountain lake surrounded by nature"
        class="absolute inset-0 h-full w-full object-cover"
        widths={[640, 1024, 1600]}
        sizes="100vw"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#263A36]/90 via-[#50635F]/65 to-[#50635F]/20"></div>
      <div class="relative flex min-h-[360px] max-w-6xl items-end px-7 pb-10 text-white sm:min-h-[430px] sm:px-12 sm:pb-14 lg:px-16">
        <div class="max-w-2xl">
          <p class="mb-3 font-body text-xs font-semibold uppercase tracking-[0.24em] text-white/75">Contact Tripova</p>
          <h1 class="font-heading text-4xl leading-tight sm:text-5xl md:text-6xl">Let&apos;s Plan a Story Worth Telling.</h1>
          <p class="mt-4 max-w-xl font-body leading-relaxed text-white/85">
            Share the journey you have in mind. Our travel consultants will help turn it into a thoughtful itinerary made around you.
          </p>
        </div>
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-12 px-5 py-20 md:grid-cols-[0.8fr_1.2fr] md:items-start lg:py-28">
      <div>
        <p class="font-body text-xs font-semibold uppercase tracking-[0.2em] text-primary/70">Get in touch</p>
        <h2 class="mt-3 max-w-md font-heading text-3xl leading-tight text-primary sm:text-4xl">We&apos;re Here for Every Step of Your Journey.</h2>
        <p class="mt-5 max-w-md font-body leading-relaxed text-[#5B5B58]">
          Whether you already know your destination or need a little inspiration, tell us what matters to you and we&apos;ll take it from there.
        </p>

        <div class="mt-10 grid gap-6 font-body text-sm">
          <div class="border-l-2 border-primary/20 pl-5">
            <p class="font-semibold text-[#2C2C2A]">Visit us</p>
            <p class="mt-1 leading-relaxed text-[#5B5B58]">220 Sunset Avenue, Suite 400<br />Los Angeles, CA 90026</p>
          </div>
          <div class="border-l-2 border-primary/20 pl-5">
            <p class="font-semibold text-[#2C2C2A]">Talk to us</p>
            <a href="tel:+12135550189" class="mt-1 block text-[#5B5B58] transition-colors hover:text-primary">+1 (213) 555-0189</a>
          </div>
          <div class="border-l-2 border-primary/20 pl-5">
            <p class="font-semibold text-[#2C2C2A]">Write to us</p>
            <a href="mailto:hello@tripova.com" class="mt-1 block text-[#5B5B58] transition-colors hover:text-primary">hello@tripova.com</a>
          </div>
        </div>
      </div>

      <form class="grid grid-cols-1 gap-5 rounded-3xl bg-[#F3F4F0] p-6 text-[#2C2C2A] shadow-[0_24px_70px_rgba(44,44,42,0.08)] sm:grid-cols-2 sm:p-9">
        <div class="flex flex-col gap-2">
          <label for="full-name" class="font-body text-xs font-semibold">Full Name</label>
          <input id="full-name" name="name" type="text" autocomplete="name" required placeholder="Jane Smith" class="rounded-xl border border-black/10 bg-white px-4 py-3 font-body text-sm outline-none transition focus:border-primary" />
        </div>
        <div class="flex flex-col gap-2">
          <label for="email" class="font-body text-xs font-semibold">Email Address</label>
          <input id="email" name="email" type="email" autocomplete="email" required placeholder="jane@email.com" class="rounded-xl border border-black/10 bg-white px-4 py-3 font-body text-sm outline-none transition focus:border-primary" />
        </div>
        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="subject" class="font-body text-xs font-semibold">Subject</label>
          <input id="subject" name="subject" type="text" required placeholder="How can we help?" class="rounded-xl border border-black/10 bg-white px-4 py-3 font-body text-sm outline-none transition focus:border-primary" />
        </div>
        <div class="flex flex-col gap-2 sm:col-span-2">
          <label for="message" class="font-body text-xs font-semibold">Message</label>
          <textarea id="message" name="message" rows="6" required placeholder="Tell us about your dream trip..." class="resize-none rounded-xl border border-black/10 bg-white px-4 py-3 font-body text-sm outline-none transition focus:border-primary"></textarea>
        </div>
        <button type="submit" class="mt-2 rounded-full bg-primary px-6 py-3.5 font-body text-sm font-semibold text-white transition hover:-translate-y-0.5 hover:bg-primary/90 sm:col-span-2">
          Send Your Message
        </button>
        <p class="font-body text-xs leading-relaxed text-[#777772] sm:col-span-2">
          We usually respond within one business day.
        </p>
      </form>
    </section>
  </main>

  <Footer />
</Layout>
