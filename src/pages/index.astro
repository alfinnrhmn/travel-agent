---
import Layout from '../layouts/Layout.astro'
import Navbar from '../components/Navbar.astro'
import HeroSection from '../components/HeroSection.astro'
import PopularDestination from '../components/PopularDestination.astro'
import BestTravelPackage from '../components/BestTravelPackage.astro'
import EveryDetailSection from '../components/EveryDetailSection.astro'
import Testimonial from '../components/Testimonial.astro'
import ContactForm from '../components/ContactForm.astro'
import Footer from '../components/Footer.astro'
import heroImg from '../assets/Image Hero.jpg'
---

<Layout
  title="Tripova — Every Trip Has a Story"
  description="Discover personalized travel packages for solo adventures, couples, groups, families, and honeymoons with thoughtful planning from Tripova."
  image={heroImg}
>
  <Navbar />
  <HeroSection />
  <main>
    <PopularDestination />
    <BestTravelPackage />
    <EveryDetailSection />
    <Testimonial />
    <ContactForm />
    <Footer />
  </main>
</Layout>
